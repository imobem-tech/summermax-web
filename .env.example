# ============================================================
# EXEMPLO DE VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env e preencha com seus dados
# V.2606181527
# ============================================================

# Servidor
PORT=3000
NODE_ENV=production

# Banco de Dados NEON
DB_HOST=seu-host.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=seu-usuario
DB_PASSWORD=sua-senha
DB_SSL=true

# JWT
JWT_SECRET=sua-chave-secreta-super-segura-aqui
JWT_EXPIRES_IN=24h

# Session
SESSION_SECRET=sua-session-secret-super-segura-aqui

# Frontend URL (para CORS)
FRONTEND_URL=https://seu-dominio.railway.app

# Timezone
TZ=America/Sao_Paulo

